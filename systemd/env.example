# Template environment untuk JARVIS Otonom
# Copy file ini ke /etc/jarvis-otonom.env, lalu isi value sebenarnya
#
#   sudo cp systemd/env.example /etc/jarvis-otonom.env
#   sudo nano /etc/jarvis-otonom.env
#   sudo chmod 600 /etc/jarvis-otonom.env

# Groq API key — daftar gratis di https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY_HERE

# Model Groq (default: openai/gpt-oss-120b)
JARVIS_GROQ_MODEL=openai/gpt-oss-120b

# URL chat server (Socket.IO)
CHAT_URL=http://127.0.0.1:3001
